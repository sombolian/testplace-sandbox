<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141420">

    <!-- Game View -->
    <com.clashroyale.clone.game.BattleView
        android:id="@+id/battleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="160dp" />

    <!-- Flash overlay for effects -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Bottom Card Tray -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/card_tray_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="12dp">

        <!-- Elixir Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/elixirBar"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:max="100"
                android:progress="50"
                android:progressTint="#9C27B0"
                android:progressBackgroundTint="#333344" />

            <TextView
                android:id="@+id/elixirText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5/10"
                android:textSize="14sp"
                android:textColor="#CE93D8"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Card Hand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp">

            <!-- Next card indicator -->
            <FrameLayout
                android:id="@+id/nextCardView"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:background="@drawable/next_card_bg"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:text="Next"
                    android:textSize="8sp"
                    android:textColor="#80FFFFFF" />

            </FrameLayout>

            <!-- Cards -->
            <LinearLayout
                android:id="@+id/cardHandContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
